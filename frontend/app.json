{
  "expo": {
    "name": "DeliveryApp",
    "slug": "delivery-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitoriadelivery.app"
    },
    "android": {
      "package": "com.vitoriadelivery.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFBF7"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "lang": "pt-BR",
      "description": "Peça comida com facilidade - restaurantes, entregadores e pedidos em um só app.",
      "themeColor": "#FFFBF7"
    },
    "plugins": [
  "expo-font",
  [
    "expo-splash-screen",
    {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBF7"
    }
  ],
  [
    "expo-location",
    {
      "locationWhenInUsePermission": "Usamos sua localização para mostrar seu endereço de entrega."
    }
  ],
  [
    "expo-image-picker",
    {
      "photosPermission": "Precisamos acessar suas fotos para você escolher a logo, o banner e as fotos dos itens do cardápio."
    }
  ],
  [
    "expo-notifications",
    {
      "icon": "./src/img/logo.png",
      "color": "#FFFBF7"
    }
  ]
]
  }
}
